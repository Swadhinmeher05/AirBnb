<% layout("/layouts/boilerplate") %>

<style>
  .filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
  }

  .filters {
    gap: 1.5rem;
    align-items: center;
  }

  .filter-toggle {
    background-color: rgb(207, 58, 29);
    color: aliceblue;
    border: none;
    border-radius: 0.8rem;
    padding: 0.4rem 1rem;
  }

  /* Phones: the opened menu is a wrapped grid with a background */
  @media (max-width: 767.98px) {
    .filters {
      width: 100%;
      flex-wrap: wrap;
      background-color: antiquewhite;
      border-radius: 0.8rem;
      padding: 0.75rem;
      gap: 1rem;
    }
    .filters.show {
      display: flex;
    }
    .filter {
      flex: 0 0 22%;      /* about 4 per row */
      text-align: center;
    }
  }
</style>

<div class="filters-bar">

  <!-- Phones only: one button that opens the categories -->
  <button class="filter-toggle d-md-none" type="button"
          data-bs-toggle="collapse" data-bs-target="#filterMenu"
          aria-controls="filterMenu" aria-expanded="false" aria-label="Toggle filters">
    <i class="fa-solid fa-bars"></i> Filters
  </button>

  <!-- Collapsed on phones, always visible from md up -->
  <div class="collapse d-md-flex filters" id="filterMenu">
    <a href="/listings?category=trending" class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </a>
    <a href="/listings?category=room" class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Room</p>
    </a>
    <a href="/listings?category=mountain" class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountain</p>
    </a>
    <a href="/listings?category=iconic_city" class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic City</p>
    </a>
    <a href="/listings?category=pool" class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Pool</p>
    </a>
    <a href="/listings?category=camping" class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </a>
    <a href="/listings?category=farm" class="filter">
      <div><i class="fa-solid fa-building-wheat"></i></div>
      <p>Farm</p>
    </a>
    <a href="/listings?category=arctic" class="filter">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </a>
  </div>

  <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" checked>
      <label class="form-check-label" for="switchCheckChecked">Display total After Taxes</label>
    </div>
  </div>

</div>

<div class="row listing-row">
  <% if (allListing.length === 0) { %>
    <div class="text-center mt-5">
      <h4>No listings found<%= category ? " in " + category.replace("_", " ") : "" %>.</h4>
      <a href="/listings" class="btn btn-dark mt-3">View all listings</a>
    </div>
  <% } else { %>
    <% for (let list of allListing) { %>
      <div class="col-md-4 col-lg-3 mb-4">
        <a href="/listings/<%= list._id %>" class="listing-link">
          <div class="card listing-card">
            <img src="<%= list.image.url %>" class="card-img-top" alt="listing_img">
            <div class="card-body">
              <h5 class="card-title"><%= list.title %></h5>
              <p class="card-location">
                <%= list.location %>, <%= list.country %>
              </p>
              <p class="card-price">
                ₹<%= list.price != null ? list.price.toLocaleString("en-IN") : "N/A" %>
                <span>/ night</span>
                <i class="tax-info">&nbsp;+18% GST</i>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  <% } %>
</div>