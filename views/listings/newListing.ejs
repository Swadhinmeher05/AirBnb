<% layout("/layouts/boilerplate") %>
<body>
    <div class="form-container">
        <h2>Create A Listing</h2>
        <form method="POST" action="/listings" 
            novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label>Title</label>
                <input type="text" name="listing[title]" placeholder="Enter title"  class="form-control" required>
                <div class="valid-feedback">
                    Correct! 👍
                </div>
                <div class="invalid-feedback">
                    Please enter valid title
                </div>
            </div>
            
            <div class="mb-3">
                <label>Description</label>
                <textarea name="listing[description]" placeholder="Enter description.." class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please enter valid Description
                </div>
                <div class="valid-feedback">
                   Correct! 👍
                </div>
            </div>
            
            <div class="mb-3" >
                <label>Upload Image</label>
                <input type="file" name="listing[image]" class="form-control" required> 
                <div class="invalid-feedback">
                    Please enter valid url
                </div>
                <div class="valid-feedback">
                    Correct! 👍
                </div>
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select class="form-select" name="listing[category]" id="category" required>
                    <option value="" disabled selected>Select type</option>
                    <option value="trending">Trending</option>
                    <option value="room">Room</option>
                    <option value="mountain">Mountain</option>
                    <option value="iconic_city">Iconic City</option>
                    <option value="pool">Pool</option>
                    <option value="camping">Camping</option>
                    <option value="farm">Farm</option>
                    <option value="arctic">Arctic</option>
                </select>
            </div>
            
            <div class="mb-3">
                <label>Price</label>
                <input type="number" name="listing[price]" placeholder="Enter price" class="form-control" required>
                <div class="invalid-feedback">
                    Please enter valid price
                </div>
                <div class="valid-feedback">
                   Correct! 👍
                </div>
            </div>
            

            <div class="mb-3">
                <label>Location</label>
                <input type="text" name="listing[location]" placeholder="Enter location"  class="form-control"  required>
                <div class="invalid-feedback">
                    Please enter valid location
                </div>
                <div class="valid-feedback">
                    Correct! 👍
                </div>
            </div>
            
            <div class="mb-3">
                <label>Country</label>
                <input type="text" name="listing[country]" placeholder="Enter country"   class="form-control" required>
                <div class="invalid-feedback">
                    Please enter valid Country
                </div>
                <div class="valid-feedback">
                    Correct! 👍
                </div>
            </div>
            <button type="submit">Add Listing</button>
        </form>
    </div>
</body>
