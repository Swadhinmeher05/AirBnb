<% layout("/layouts/boilerplate") %>

<body>
    <div class="form-container">
        <h2>Edit your listing</h2>
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label >Title</label>
                <input 
                    type="text" 
                    name="listing[title]" 
                    value="<%= listing.title %>"
                    required
                    class="form-control"
                >
            </div>
           
            <div class="mb-3">
                <label>Description</label>
                <textarea 
                    name="listing[description]"
                    required
                    class="form-control"
                ><%= listing.description %></textarea>
            </div>
            
            <div class="mb-3">
                <label>Upload New Image</label>
                <input 
                    type="file" 
                    name="listing[image]" 
                    value="<%= listing.image %>"
                    class="form-control"
                >
                <div class="valid-feedback">
                    Correct! 👍
                </div>
                <div class="invalid-feedback">
                    Please enter valid title
                </div>
            </div>
            
            <div class="mb-3">
                <label>Price</label>
                <input 
                    type="number" 
                    name="listing[price]" 
                    value="<%= listing.price %>"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Correct! 👍
                </div>
                <div class="invalid-feedback">
                    Please enter valid title
                </div>
            </div>
            
            <div class="mb-3">
                <label>Location</label>
                <input 
                    type="text" 
                    name="listing[location]" 
                    value="<%= listing.location %>"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Correct! 👍
                </div>
                <div class="invalid-feedback">
                    Please enter valid title
                </div>
            </div>
            
            <div class="mb-3">
                <label>Country</label>
                <input 
                    type="text" 
                    name="listing[country]" 
                    value="<%= listing.country %>"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Correct! 👍
                </div>
                <div class="invalid-feedback">
                    Please enter valid title
                </div>
            </div>
            <button type="submit">Edit Listing</button>
        </form>
    </div>
</body>