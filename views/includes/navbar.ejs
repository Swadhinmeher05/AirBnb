<style>
  .navbar {
    height: auto !important;          
    min-height: 4.5rem;
    background-color: antiquewhite;   
    z-index: 1030;
  }

  .search-btn {
    background-color: rgb(207, 58, 29);
    color: aliceblue;
    border-radius: 0.8rem;
    border: none;
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }

  .navbar .form-control {
    width: 100%;
    min-width: 0;
    border-radius: 0.8rem;
  }

  .navbar .search-form {
    flex: 1 1 0;
    min-width: 0;
    max-width: 30rem;
    margin: 0 0.5rem;
  }

  @media (min-width: 768px) {
    .navbar .search-form {
      margin: 0 auto;     
    }
  }

  @media (max-width: 767.98px) {
    .navbar-collapse {
      background-color: antiquewhite; 
      padding: 0.5rem 0.5rem 1rem;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      width: 100%;
    }
    .search-btn .btn-text { display: none; }
  }
</style>

<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <form class="d-flex search-form" role="search" action="/listings" method="GET">
      <input class="form-control me-2" type="search" placeholder="Search destination" name="q" />
      <button class="search-btn" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span class="btn-text">Search</span>
      </button>
    </form>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings">Explore</a>
        <a class="nav-link" href="/listings/newListing">AirBnb your Home</a>
        <% if(!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } else { %>
          <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>